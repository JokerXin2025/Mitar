{
  "$schema": "https://json-schema.org/draft/2020-12/schema" ,
  "$defs" : {
    "CasesByConclusion" : {
      "properties" : {
        "strategy" : { "const" : "Cases" } ,
        "principle" : { "type" : "string" } ,
        "cases" : {
          "type" : "array" ,
          "items" : { "$ref" : "#/$defs/Proof" } ,
          "minItems" : 2 ,
          "uniqueItems": true
        }
      } ,
      "required" : [ "by" , "principle" , "cases" ] ,
      "additionalProperties" : false
    } ,
    "Contradiction" : {
      "properties" : {
        "strategy" : { "const" : "Contradiction" } ,
        "h_contra" : { "type" : "string" } ,
        "proof" : { "$ref" : "#/$defs/Proof" }
      } ,
      "required" : [ "is_strategy" , "by" , "h_contra" , "proof" ] ,
      "additionalProperties" : false
    } ,
    "Induction": {
      "properties": {
        "name": {"const": "Induction"},
        "info": {
          "properties": {
            "on": {
              "type": "string"
            }
          }
        },
        "base": {
          "$ref": "#/$defs/Proof",
          "items": [
            {}
          ]
        },
      
        "inductive": {
          "properties": {
            "on": {
              "type": "string"
            }
          }
        },
        "inductive_proof" : { "$ref" : "#/$defs/Proof" }
      }
    } ,
    "rfl" : {
      "properties" : {
        "step" : { "const" : "rfl" }
      } ,
      "required" : [ "step" ] ,
      "additionalProperties" : false
    } ,
    "unfold" : {
      "properties" : {
        "step" : { "const" : "unfold" } ,
        "const" : { "type": "string" } ,
        "h" : { "type" : "string" } ,
        "h_" : { "type" : "string" } ,
        "goal_" : { "type" : "string" }
      } ,
      "required" : [ "step" , "const" ] ,
      "additionalProperties" : false
    } ,
    "change" : {
      "properties" : {
        "step" : { "const" : "change" } ,
        "expr" : { "type": "string" } ,
        "h" : { "type" : "string" }
      } ,
      "required" : [ "step" , "expr" ] ,
      "additionalProperties" : false
    } ,
    "apply" : {
      "properties" : {
        "step" : { "const" : "apply" } ,
        "thm" : { "type": "string" } ,
        "goal" : { "type": "string" } ,
        "goal_" : { "type": "string" }
      } ,
      "required" : [ "step" , "thm" , "goal" , "goal_" ] ,
      "additionalProperties" : false
    } ,
    "norm_num" : {
      "properties" : {
        "step" : { "const" : "norm_num" } ,
        "h" : { "type" : "string" } ,
        "h_" : { "type" : "string" } ,
        "goal" : { "type" : "string" } ,
        "goal_" : { "type" : "string" }
      } ,
      "required" : [ "step" , "goal" ] ,
      "additionalProperties" : false
    } ,
    "omega" : {
      "properties" : {
        "step" : { "const" : "omega" } ,
        "goal" : { "type" : "string" }
      } ,
      "required" : [ "step" , "goal" ] ,
      "additionalProperties" : false
    } ,
    "linarith" : {
      "properties" : {
        "step" : { "const" : "linarith" } ,
        "goal" : { "type" : "string" }
      } ,
      "required" : [ "step" , "goal" ] ,
      "additionalProperties" : false
    } ,
    "nlinarith" : {
      "properties" : {
        "step" : { "const" : "nlinarith" } ,
        "goal" : { "type" : "string" }
      } ,
      "required" : [ "step" , "goal" ] ,
      "additionalProperties" : false
    } ,
    "ring" : {
      "properties" : {
        "step" : { "const" : "ring" } ,
        "goal" : { "type" : "string" }
      } ,
      "required" : [ "step" , "goal" ] ,
      "additionalProperties" : false
    } ,
    "gcongr" : {
      "properties" : {
        "step" : { "const" : "gcongr" } ,
        "goal" : { "type" : "string" } ,
        "goal_" : { "type" : "string" }
      } ,
      "required" : [ "step" , "goal" ] ,
      "additionalProperties" : false
    } ,
    "have" : {
      "properties" : {
        "step" : { "const" : "have" } ,
        "trivial" : { "type" : "boolean" } ,
        "proposition" : { "type" : "string" } ,
        "proof" : { "$ref" : "#/$defs/Proof" }
      } ,
      "required" : [ "step" , "trivial" , "proposition" , "proof" ] ,
      "additionalProperties" : false
    } ,
    "calculation" : {
      "properties" : {
        "calculation" : { "const" : true } ,
        "init_term" : { "type" : "string" } ,
        "chain" : {
          "type" : "array" ,
          "items" : {
            "type" : "object" ,
            "properties" : {
              "next_term" : { "type" : "string" } ,
              "relation" : {
                "type" : "string" ,
                "examples" : [ "=" , "<" , "≤" ]
              } ,
              "reason" : { "$ref" : "#/$defs/Proof" }
            } ,
            "required" : [ "next_term" , "relation" , "reason" ] ,
            "additionalProperties" : false
          } ,
          "minItems" : 1
        }
      } ,
      "required" : [ "calculation" , "init_term" , "chain" ] ,
      "additionalProperties" : false
    },
    "Proof" : {
      "oneOf" : [
        {
          "type" : "object" ,
          "properties" : {
            "item" : {
              "type" : "string"
            }
          } ,
          "required" : [ "use" , "item" ] ,
          "additionalProperties" : false
        } ,
        {
          "type" : "array" ,
          "items" : {
            "oneOf" : [
              { "$ref" : "#/$defs/Cases" } ,
              { "$ref" : "#/$defs/Contradiction" } ,
              { "$ref" : "#/$defs/Induction" } ,
              { "$ref" : "#/$defs/rfl" } ,
              { "$ref" : "#/$defs/unfold" } ,
              { "$ref" : "#/$defs/change" } ,
              { "$ref" : "#/$defs/apply" } ,
              { "$ref" : "#/$defs/norm_num" } ,
              { "$ref" : "#/$defs/omega" } ,
              { "$ref" : "#/$defs/linarith" } ,
              { "$ref" : "#/$defs/nlinarith" } ,
              { "$ref" : "#/$defs/ring" } ,
              { "$ref" : "#/$defs/gcongr" } ,
              { "$ref" : "#/$defs/have" } ,
              { "$ref" : "#/$defs/calculation" }
            ]
          }
        }
      ]
    }
  } ,
  "$ref" : "#/$defs/Proof"
}